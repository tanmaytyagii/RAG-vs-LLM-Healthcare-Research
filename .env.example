# Copy this file to .env and fill in values as needed.
# config.py reads these via os.getenv(), so .env is optional if you
# prefer to export variables directly in your shell.

# --- Inference backend selection ---
# One of: ollama | hf_inference | local
LLM_BACKEND=ollama

# --- Ollama backend (default, recommended for local dev) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3:8b-instruct

# --- HuggingFace Inference Endpoint backend ---
HF_TOKEN=
LLM_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct

# --- Generation parameters ---
LLM_TEMPERATURE=0.2
LLM_MAX_NEW_TOKENS=512
LLM_TOP_P=0.9
LLM_REPETITION_PENALTY=1.1

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.0

# --- Logging ---
LOG_LEVEL=INFO
